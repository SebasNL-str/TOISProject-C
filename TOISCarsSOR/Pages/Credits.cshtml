@page
@{
    ViewData["Title"] = "TOISphera Says Ka-chow: Créditos";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/credits.css"
          asp-append-version="true" />
}

<section class="credits-page">

    <div class="container credits-container">
        <section class="project-credit text-center"
                 data-aos="fade-down">

            <a asp-page="/Index"
               class="brand"
               aria-label="Volver al inicio">

                <img
                    src="~/assets/images/toiscarsv2.png"
                    alt="TOISCarsLogo"
                    class="brand-logo">
            </a>

            <span class="project-credit-label">
                <i class="bi bi-mortarboard"></i>
                UN PROYECTO DE FIN DE CURSO
            </span>

            <h2 class="project-credit-title">
                Sistemas Operativos y Redes de Computadoras
            </h2>

            <div class="project-credit-divider"></div>

            <div class="project-credit-details">

                <div class="project-detail">
                    <i class="bi bi-building"></i>
                    <span>Universidad Nacional de Ingenieria</span>
                </div>

                <div class="project-detail">
                    <i class="bi bi-person-workspace"></i>
                    <span>Docente: MSc. Danny Oswaldo Chavez Miranda</span>
                </div>

            </div>
        </section>

        <header class="credits-header text-center"
                data-aos="zoom-in">

            <h1 class="credits-title">
                <span>Desarrollado por:</span>
            </h1>

        </header>

        <div class="row justify-content-center g-4 credits-team">

            <div class="col-12 col-sm-6 col-lg-4"
                 data-aos="fade-right"
                 data-aos-delay="100">

                <article class="credit-card">

                    <div class="credit-avatar-wrapper credit-avatar-wrapper1">
                        <img
                            src="https://github.com/cBOr50.png"
                            asp-append-version="true"
                            alt="Fotografía de Braulio"
                            class="credit-avatar"
                            loading="lazy" />
                    </div>

                    <div class="credit-information">

                        <span class="credit-member-number">
                            INTEGRANTE #1
                        </span>

                        <h2 class="credit-name">
                            <a href="https://github.com/cBOr50"
                            target="_blank"
                            rel="noopener noreferrer">
                                Bradly Ortiz
                            </a>
                        </h2>

                        <p class="credit-role">
                            Doc Hudson
                        </p>

                    </div>

                </article>

            </div>

            <div class="col-12 col-sm-6 col-lg-4"
                 data-aos="fade-right"
                 data-aos-delay="200">

                <article class="credit-card">

                    <div class="credit-avatar-wrapper credit-avatar-wrapper2">
                        <img
                            src="https://github.com/SebasNL-str.png"
                            asp-append-version="true"
                            alt="Fotografía de Cebras"
                            class="credit-avatar"
                            loading="lazy" />
                    </div>

                    <div class="credit-information">

                        <span class="credit-member-number">
                            INTEGRANTE #2
                        </span>

                        <h2 class="credit-name">
                            <a href="https://github.com/SebasNL-str"
                            target="_blank"
                            rel="noopener noreferrer">
                                Jose Narvaez
                            </a>
                        </h2>

                        <p class="credit-role">
                            Cruz Ramirez
                        </p>

                    </div>

                </article>

            </div>

            <div class="col-12 col-sm-6 col-lg-4"
                 data-aos="fade-left"
                 data-aos-delay="300">

                <article class="credit-card">

                    <div class="credit-avatar-wrapper credit-avatar-wrapper3">
                        <img
                            src="https://github.com/EndministratorI.png"
                            asp-append-version="true"
                            alt="Fotografía de Nombre Apellido"
                            class="credit-avatar"
                            loading="lazy" />
                    </div>

                    <div class="credit-information">

                        <span class="credit-member-number">
                            INTEGRANTE #3
                        </span>

                        <h2 class="credit-name">
                            <a href="https://github.com/EndministratorI"
                            target="_blank"
                            rel="noopener noreferrer">
                                Michael Brenes
                            </a>
                        </h2>

                        <p class="credit-role">
                            Strip "El Rey" Weathers
                        </p>

                    </div>

                </article>

            </div>

            <div class="col-12 col-sm-6 col-lg-4"
                 data-aos="fade-left"
                 data-aos-delay="300">

                <article class="credit-card">

                    <div class="credit-avatar-wrapper credit-avatar-wrapper4">
                        <img
                            src="https://github.com/yarathel.png"
                            asp-append-version="true"
                            alt="Fotografía de Nombre Apellido"
                            class="credit-avatar"
                            loading="lazy" />
                    </div>

                    <div class="credit-information">

                        <span class="credit-member-number">
                            INVITADO ESPECIAL
                        </span>

                        <h2 class="credit-name">
                            <a href="https://github.com/yarathel"
                            target="_blank"
                            rel="noopener noreferrer">
                                Yader Benavides
                            </a>
                        </h2>

                        <p class="credit-role">
                            Lightning McQueen
                        </p>

                    </div>

                </article>

            </div>

        </div>

    </div>

</section>
