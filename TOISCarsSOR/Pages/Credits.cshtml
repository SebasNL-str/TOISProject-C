@page
@{
    ViewData["Title"] = "Créditos";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/credits.css"
          asp-append-version="true" />
}

<section class="credits-page">

    <div class="container credits-container">

        <!-- Encabezado -->
        <header class="credits-header text-center"
                data-aos="fade-up">

            <span class="credits-eyebrow">
                DETRÁS DEL PROYECTO
            </span>

            <h1 class="credits-title">
                Conoce al <span>equipo</span>
            </h1>

            <p class="credits-description">
                Este proyecto es el resultado del esfuerzo, la creatividad
                y la colaboración de cada uno de sus integrantes.
                Conoce a las personas que hicieron esto posible.
            </p>

        </header>


        <!-- Integrantes del proyecto -->
        <div class="row justify-content-center g-4 credits-team">

            <!-- Integrante 1 -->
            <div class="col-12 col-sm-6 col-lg-4"
                 data-aos="fade-up"
                 data-aos-delay="100">

                <article class="credit-card">

                    <div class="credit-avatar-wrapper">
                        <img
                            src="~/assets/images/Arkhy.png"
                            asp-append-version="true"
                            alt="Fotografía de Braulio"
                            class="credit-avatar"
                            loading="lazy" />
                    </div>

                    <div class="credit-information">

                        <span class="credit-member-number">
                            INTEGRANTE 01
                        </span>

                        <h2 class="credit-name">
                            Bradly Ortiz
                        </h2>

                        <p class="credit-role">
                            Doc Hudson
                        </p>

                        <p class="credit-bio">
                            Breve descripción de su participación
                            en el desarrollo del proyecto.
                        </p>

                    </div>

                </article>

            </div>

            <div class="col-12 col-sm-6 col-lg-4"
                 data-aos="fade-up"
                 data-aos-delay="200">

                <article class="credit-card">

                    <div class="credit-avatar-wrapper">
                        <img
                            src="~/assets/images/SebasNTR.png"
                            asp-append-version="true"
                            alt="Fotografía de Cebras"
                            class="credit-avatar"
                            loading="lazy" />
                    </div>

                    <div class="credit-information">

                        <span class="credit-member-number">
                            INTEGRANTE 02
                        </span>

                        <h2 class="credit-name">
                            Jose Narvaez
                        </h2>

                        <p class="credit-role">
                            Cruz Ramirez
                        </p>

                        <p class="credit-bio">
                            Breve descripción de su participación
                            en el desarrollo del proyecto.
                        </p>

                    </div>

                </article>

            </div>


            <!-- Integrante 3 -->
            <div class="col-12 col-sm-6 col-lg-4"
                 data-aos="fade-up"
                 data-aos-delay="300">

                <article class="credit-card">

                    <div class="credit-avatar-wrapper">
                        <img
                            src="~/assets/images/Freedom.jpg"
                            asp-append-version="true"
                            alt="Fotografía de Nombre Apellido"
                            class="credit-avatar"
                            loading="lazy" />
                    </div>

                    <div class="credit-information">

                        <span class="credit-member-number">
                            INTEGRANTE 03
                        </span>

                        <h2 class="credit-name">
                            Michael Brenes
                        </h2>

                        <p class="credit-role">
                            Strip "El Rey" Weathers
                        </p>

                        <p class="credit-bio">
                            Breve descripción de su participación
                            en el desarrollo del proyecto.
                        </p>

                    </div>

                </article>

            </div>


        <!-- Integrante 4 -->
            <div class="col-12 col-sm-6 col-lg-4"
                 data-aos="fade-up"
                 data-aos-delay="300">

                <article class="credit-card">

                    <div class="credit-avatar-wrapper">
                        <img
                            src="~/assets/images/Yarathel.jpg"
                            asp-append-version="true"
                            alt="Fotografía de Nombre Apellido"
                            class="credit-avatar"
                            loading="lazy" />
                    </div>

                    <div class="credit-information">

                        <span class="credit-member-number">
                            INTEGRANTE INVITADO
                        </span>

                        <h2 class="credit-name">
                            Yader Benavides
                        </h2>

                        <p class="credit-role">
                            Lightning McQueen
                        </p>

                        <p class="credit-bio">
                            Breve descripción de su participación
                            en el desarrollo del proyecto.
                        </p>

                    </div>

                </article>

            </div>

        </div>


        <!-- Información académica -->
        <section class="project-credit text-center"
                 data-aos="fade-up">

            <span class="project-credit-label">
                <i class="bi bi-mortarboard"></i>
                UN PROYECTO ACADÉMICO
            </span>

            <h2 class="project-credit-title">
                Sistemas Operativos y Redes de Computadoras
            </h2>

            <div class="project-credit-divider"></div>

            <div class="project-credit-details">

                <div class="project-detail">
                    <i class="bi bi-building"></i>
                    <span>Universidad Nacional de Ingenieria</span>
                </div>

                <div class="project-detail">
                    <i class="bi bi-person-workspace"></i>
                    <span>Tutor: Danny Oswaldo Chavez Miranda</span>
                </div>

                <div class="project-detail">
                    <i class="bi bi-calendar3"></i>
                    <span>2026</span>
                </div>

            </div>

        </section>

    </div>

</section>
