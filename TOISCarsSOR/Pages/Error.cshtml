@page
@model ErrorModel
@{
    ViewData["Title"] = "TOISphera Says Ka-chow: Error";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/disclaimer.css"
          asp-append-version="true" />
}

<main class="disclaimer-page">
    <div class="disclaimer-container" data-aos="zoom-out">

        <section class="disclaimer-panel"
                 aria-labelledby="disclaimer-heading">

            <a asp-page="/Index"
               class="brand"
               aria-label="Volver al inicio">

                <img
                    src="~/assets/images/toiscarsv2.png"
                    alt="TOISCarsLogo"
                    class="brand-logo">
            </a>

            <div class="disclaimer-panel-heading">

                <div class="disclaimer-symbol"
                     aria-hidden="true">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                </div>

                <div class="disclaimer-heading-content">

                    <span class="disclaimer-label">
                        ERROR
                    </span>

                    <h2 id="disclaimer-heading"
                        class="disclaimer-panel-title">
                        Something went wrong
                    </h2>

                </div>

            </div>

            <div class="disclaimer-content">

                <p>
                    An unexpected error occurred while processing
                    your request. We're sorry for the inconvenience.
                </p>

                <p>
                    The problem may be temporary. Please try again
                    in a few moments.
                </p>

                @if (Model.ShowRequestId)
                {
                    <p>
                        <strong>Request ID:</strong>
                        <code>@Model.RequestId</code>
                    </p>
                }

            </div>

            <div class="disclaimer-divider"
                 aria-hidden="true">
            </div>

            <div class="disclaimer-notes">

                <div class="disclaimer-note">

                    <span class="disclaimer-note-indicator"
                          aria-hidden="true">
                    </span>

                    <div>
                        <h3>Try again</h3>

                        <p>
                            Refresh the page or repeat your request
                            in a few moments.
                        </p>
                    </div>

                </div>

                <div class="disclaimer-note">

                    <span class="disclaimer-note-indicator"
                          aria-hidden="true">
                    </span>

                    <div>
                        <h3>Development mode</h3>

                        <p>
                            Detailed error information is available
                            only when running the application in
                            the Development environment.
                        </p>
                    </div>

                </div>

            </div>

            @if (Environment.GetEnvironmentVariable("ASPNETCORE_ENVIRONMENT") == "Development")
            {
                <div class="disclaimer-divider"
                     aria-hidden="true">
                </div>

                <div class="disclaimer-content">
                    <p>
                        <strong>Development environment enabled.</strong>
                        Detailed exception information may be available
                        in the application's debugging output.
                    </p>

                    <p>
                        Do not enable the Development environment
                        in deployed applications, as it may expose
                        sensitive information.
                    </p>
                </div>
            }

        </section>

    </div>
</main>

