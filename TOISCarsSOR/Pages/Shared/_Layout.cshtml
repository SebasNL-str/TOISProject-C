<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Tu marca</title>

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css"
          asp-append-version="true" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- CSS principal -->
    <link rel="stylesheet"
          href="~/css/layout.css"
          asp-append-version="true" />
</head>

<body class="site-body">

    <!-- Contenido de Razor Pages -->
    <main class="site-main">
        @RenderBody()
    </main>

    <!-- Footer fijo con transparencia -->
    <footer class="site-footer">
        <div class="container">

            <div class="footer-content">

                <!-- Marca y placeholder del logo -->
                <div class="footer-brand">
                    <a asp-page="/Index" class="footer-logo">
                        <div class="footer-logo-placeholder">
                            <i class="bi bi-image"></i>
                        </div>

                        <span>Tu marca</span>
                    </a>

                    <p class="footer-description">
                        Una breve descripción de tu proyecto.
                    </p>
                </div>

                <!-- Enlaces -->
                <nav class="footer-links"
                     aria-label="Enlaces del pie de página">

                    <a href="https://github.com/tu-usuario/tu-repositorio"
                       target="_blank"
                       rel="noopener noreferrer"
                       aria-label="Visitar repositorio en GitHub">

                        <i class="bi bi-github"></i>
                        <span>GitHub</span>
                    </a>

                    <a asp-page="/Terms"
                       aria-label="Términos y condiciones">

                        <i class="bi bi-file-earmark-text"></i>
                        <span>Términos y condiciones</span>
                    </a>
                </nav>
            </div>

            <!-- Copyright y disclaimer -->
            <div class="footer-bottom">
                <span>
                    &copy; @DateTime.Now.Year Tu marca.
                    Todos los derechos reservados.
                </span>

                <span class="footer-disclaimer">
                    Uso sujeto a los términos del sitio.
                </span>
            </div>

        </div>
    </footer>

    <!-- Bootstrap JavaScript -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>


