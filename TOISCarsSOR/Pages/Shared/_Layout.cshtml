<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="icon" type="image/x-icon" href="/favicon.ico">

    <title>@ViewData["Title"]</title>

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css"
          asp-append-version="true" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- CSS principal -->
    <link rel="stylesheet"
          href="~/css/layout.css"
          asp-append-version="true" />
</head>

<body class="site-body">

    <!-- Contenido de Razor Pages -->
    <main class="site-main">
        @RenderBody()
    </main>

    <!-- Footer con transparencia -->
    <footer class="site-footer">
        <div class="container">

            <div class="footer-content">

                <!-- Marca y logo del proyecto -->
                <div class="footer-brand">

                    <a asp-page="/Index" class="footer-logo">
                        <img src="~/assets/images/toispherav1wc.png"
                             asp-append-version="true"
                             alt="Logo de TOISphera"
                             class="site-logo-image3" />
                    </a>

                    <p class="footer-description">
                        Dos mundos, una misma ruta.
                    </p>

                </div>

                <!-- Enlaces del pie de página -->
                <nav class="footer-links"
                     aria-label="Enlaces del pie de página">

                    <!-- Correo electrónico -->
                    <a href="mailto:yatoortiz05@gmail.com"
                       aria-label="Enviar correo electrónico">

                        <i class="bi bi-envelope-fill"></i>
                    </a>

                    <!-- Créditos -->
                    <a asp-page="/Credits"
                       aria-label="Ver créditos del proyecto">

                        <i class="bi bi-people-fill"></i>
                    </a>

                    <!-- Términos y condiciones -->
                    <a asp-page="/Disclaimer"
                       aria-label="Consultar términos y condiciones">

                        <i class="bi bi-file-earmark-text"></i>
                    </a>

                </nav>
            </div>

            <!-- Copyright y disclaimer -->
            <div class="footer-bottom">

                <span>
                    &copy; @DateTime.Now.Year TOISphera.
                    Todos los derechos reservados.
                </span>

                <span class="footer-disclaimer">
                    Uso sujeto a los términos del sitio.
                </span>

            </div>

        </div>
    </footer>

    <!-- Bootstrap JavaScript -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>

