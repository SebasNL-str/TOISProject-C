@page
@model IndexModel
@{
    ViewData["Title"] = "TOIS Says Kachow";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <meta name="description"
          content="Explora nuestras cuatro secciones y descubre todo lo que tenemos para ti.">

    <title>Inicio | Tu Marca</title>

    <link rel="stylesheet" href="css/landing.css">
</head>

<body>

    <main class="landing">

        <header class="landing-header">

            <a href="~/Index.html"
               class="brand"
               aria-label="Volver al inicio">

                <img
                    src="~/assets/images/toiscarsv2.png"
                    alt="Logo de Tu Marca"
                    class="brand-logo">
            </a>

            <p class="brand-slogan">
                Dos mundos, una misma ruta.
            </p>

        </header>

        <nav class="sections" aria-label="Secciones principales">

            <a href="~/DocHudson"
               class="banner banner-1">

                <div class="banner-content">

                    <h2>Doc Hudson</h2>

                    <p>
                        El Fabuloso Hudson Hornet.
                    </p>

                </div>

            </a>


            <a href="~/McQueen"
               class="banner banner-2">

                <div class="banner-content">

                    <h2>Lightning McQueen</h2>

                    <p>
                        Yo desayuno perdedores.
                    </p>
                </div>

            </a>


            <a href="~/Rey"
               class="banner banner-3">

                <div class="banner-content">

                    <h2>Strip "The King" Weathers</h2>

                    <p>
                        Hola, compañero. Eres un corredor valiente.
                    </p>
                </div>

            </a>


            <a href="~/CruzRamirez"
               class="banner banner-4">

                <div class="banner-content">

                    <h2>Cruz Ramírez</h2>

                    <p>
                        Normie.
                    </p>
                </div>

            </a>

        </nav>

    </main>

</body>
</html>