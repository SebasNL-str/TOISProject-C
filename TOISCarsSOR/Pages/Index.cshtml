@page
@model IndexModel

@{
    ViewData["Title"] = "TOISphera Says Ka-chow";
    ViewData["Description"] = "Pagina tematica de Cars by Los 4 Fantasticos";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/landing.css"
          asp-append-version="true" />
}

<body>

    <main class="landing">

        <header class="landing-header">

            <a asp-page="/Index"
               class="brand"
               aria-label="Volver al inicio" data-aos="fade-down">

                <img
                    src="~/assets/images/toiscarsv2.png"
                    alt="TOISCarsLogo"
                    class="brand-logo">
            </a>

        <h1 class="golden-hour" data-aos="zoom-in">
            Dos mundos, una misma ruta.
        </h1>

        </header>

        <nav class="sections" aria-label="Secciones principales">

            <div class="banner-frame">
                        <a asp-page="/DocHudson"
                        class="banner banner-1" data-aos="fade-up">

                            <div class="banner-content">

                                <h2>Doc Hudson</h2>
                                <p>
                                    El Fabuloso Hudson Hornet.
                                </p>
                            </div>
                        </a>
            </div>

            <div class="banner-frame">
                        <a asp-page="/McQueen"
                        class="banner banner-2" data-aos="fade-up" data-aos-delay="100">

                            <div class="banner-content">

                                <h2>Lightning McQueen</h2>

                                <p>
                                    Yo desayuno perdedores.
                                </p>
                            </div>

                        </a>
            </div>

            <div class="banner-frame">
                        <a asp-page="/Rey"
                        class="banner banner-3" data-aos="fade-up" data-aos-delay="150">

                            <div class="banner-content">

                                <h2>Strip "The King" Weathers</h2>

                                <p>
                                    Nada de esto hubiera sido posible sin mi equipo.
                                </p>
                            </div>

                        </a>
            </div>

            <div class="banner-frame">
                        <a asp-page="/CruzRamirez"
                        class="banner banner-4" data-aos="fade-up" data-aos-delay="200">

                            <div class="banner-content">

                                <h2>Cruz Ramírez</h2>

                                <p>
                                    Normie.
                                </p>
                            </div>
                        </a>
            </div>


            <div class="banner-frame">
                        <a asp-page="/JacksonStorm"
                        class="banner banner-5" data-aos="fade-up" data-aos-delay="200">

                            <div class="banner-content">

                                <h2>Jackson Storm</h2>

                                <p>
                                    Normie 2.0
                                </p>
                            </div>
                        </a>
            </div>
        </nav>
    </main>

</body>
</html>