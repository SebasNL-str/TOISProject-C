@page
@{
    ViewData["Title"] = "TOISphera Says Ka-chow: Disclaimer";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/disclaimer.css"
          asp-append-version="true" />
}

<main class="disclaimer-page">
    <div class="disclaimer-container" data-aos="zoom-out">

        <section class="disclaimer-panel"
                 aria-labelledby="disclaimer-heading">

            <a asp-page="/Index"
               class="brand"
               aria-label="Volver al inicio">

                <img
                    src="~/assets/images/toiscarsv2.png"
                    alt="TOISCarsLogo"
                    class="brand-logo">
            </a>

            <div class="disclaimer-panel-heading">
                <div class="disclaimer-symbol"
                     aria-hidden="true">
                    ©
                </div>

                <div class="disclaimer-heading-content">

                    <span class="disclaimer-label">
                        DISCLAIMER
                    </span>

                    <h2 id="disclaimer-heading"
                        class="disclaimer-panel-title">
                        Fan-made project disclaimer
                    </h2>

                </div>

            </div>

            <div class="disclaimer-content">

                <p>
                    <strong>TOISphera Says Ka-chow</strong>
                    is a fan-made project created by TOISphera
                    in appreciation of Disney and Pixar’s
                    Cars franchise.
                </p>

                <p>
                    All related trademarks, characters, names,
                    logos, and intellectual property belong to
                    their respective owners.
                </p>

                <p>
                    <strong>TOISphera Says Ka-chow</strong>
                    is an independent project and is not officially
                    affiliated with, endorsed by, or sponsored by
                    Disney, Pixar, or their parent companies unless
                    explicitly stated otherwise.
                </p>

                <p>
                    This project is intended to celebrate the
                    Cars universe and its community.
                </p>

            </div>

            <div class="disclaimer-divider"
                 aria-hidden="true">
            </div>

            <div class="disclaimer-notes">

                <div class="disclaimer-note">

                    <span class="disclaimer-note-indicator"
                          aria-hidden="true">
                    </span>

                    <div>
                        <h3>Independent project</h3>

                        <p>
                            Created by TOISphera as a fan project.
                        </p>
                    </div>

                </div>

                <div class="disclaimer-note">

                    <span class="disclaimer-note-indicator"
                          aria-hidden="true">
                    </span>

                    <div>
                        <h3>Respective ownership</h3>

                        <p>
                            All intellectual property remains
                            with its respective owners.
                        </p>
                    </div>

                </div>

            </div>

        </section>

    </div>
</main>